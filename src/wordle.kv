<BoardTile>:
    font_size: 32
    color: "#e2e8f0"
    canvas.before:
        Color:
            rgba: self.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

<AlphaTile>:
    font_size: 28
    color: "#e2e8f0"
    background_normal: ''
    bakcground_down: ''

<MyLayout@FloatLayout>:
    GridLayout:
        size_hint: 0.7000, 0.4000
        pos_hint: {'x': 0.1500, 'y': 0.5500}
        spacing: 10
        padding: 10
        cols: 5
        rows: 6
        id: game_board
        BoardTile:
            text: "0x0"
        BoardTile:
            text: "0x1"
        BoardTile:
            text: "0x2"
        BoardTile:
            text: "0x3"
        BoardTile:
            text: "0x4"
        BoardTile:
            text: "1x0"
        BoardTile:
            text: "1x1"
        BoardTile:
            text: "1x2"
        BoardTile:
            text: "1x3"
        BoardTile:
            text: "1x4"
        BoardTile:
            text: "2x0"
        BoardTile:
            text: "2x1"
        BoardTile:
            text: "2x2"
        BoardTile:
            text: "2x3"
        BoardTile:
            text: "2x4"
        BoardTile:
            text: "3x0"
        BoardTile:
            text: "3x1"
        BoardTile:
            text: "3x2"
        BoardTile:
            text: "3x3"
        BoardTile:
            text: "3x4"
        BoardTile:
            text: "4x0"
        BoardTile:
            text: "4x1"
        BoardTile:
            text: "4x2"
        BoardTile:
            text: "4x3"
        BoardTile:
            text: "4x4"
        BoardTile:
            text: "5x0"
        BoardTile:
            text: "5x1"
        BoardTile:
            text: "5x2"
        BoardTile:
            text: "5x3"
        BoardTile:
            text: "5x4"

    TextInput:
        pos_hint: {'x': 0.2000, 'y': 0.4000}
        size_hint: 0.6000, 0.1000
        hint_text: "Enter text..."
        font_size: 14
        foreground_color: "#6b7280"
        on_text: app.update_text(self.text)
        id: text_input

    Button:
        pos_hint: {'x': 0.3000, 'y': 0.3050}
        size_hint: 0.4000, 0.0800
        font_size: 32
        id: guess
        text: "Submit"
        on_press: app.submit_guess()

    GridLayout:
        pos_hint: {'x': 0.1000, 'y': 0.0500}
        id: alpha
        size_hint: 0.8000, 0.2500
        cols: 10
        spacing: 10
        padding: 10
        AlphaTile:
            text: "Q"
        AlphaTile:
            text: "W"
        AlphaTile:
            text: "E"
        AlphaTile:
            text: "R"
        AlphaTile:
            text: "T"
        AlphaTile:
            text: "Y"
        AlphaTile:
            text: "U"
        AlphaTile:
            text: "I"
        AlphaTile:
            text: "O"
        AlphaTile:
            text: "P"
        AlphaTile:
            text: "A"
        AlphaTile:
            text: "S"
        AlphaTile:
            text: "D"
        AlphaTile:
            text: "F"
        AlphaTile:
            text: "G"
        AlphaTile:
            text: "H"
        AlphaTile:
            text: "J"
        AlphaTile:
            text: "K"
        AlphaTile:
            text: "L"
        AlphaTile:
            id: delete
            text: "DEL"
        AlphaTile:
            text: "Z"
        AlphaTile:
            text: "X"
        AlphaTile:
            text: "C"
        AlphaTile:
            text: "V"
        AlphaTile:
            text: "B"
        AlphaTile:
            text: "N"
        AlphaTile:
            text: "M"

<WordleApp>:
MyLayout:
