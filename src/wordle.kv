<BoardTile>:
    font_size: 32
    color: "#e2e8f0"
    canvas.before:
        Color:
            rgba: self.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

<AlphaTile@Button>:
    font_size: 28
    color: "#e2e8f0"

<MyLayout@FloatLayout>:
    GridLayout:
        size_hint: 0.7000, 0.4000
        pos_hint: {'x': 0.1500, 'y': 0.5500}
        spacing: 10
        padding: 10
        cols: 5
        rows: 6
        id: game_board
        BoardTile:
            text: "0x0"
        BoardTile:
            text: "0x1"
        BoardTile:
            text: "0x2"
        BoardTile:
            text: "0x3"
        BoardTile:
            text: "0x4"
        BoardTile:
            text: "1x0"
        BoardTile:
            text: "1x1"
        BoardTile:
            text: "1x2"
        BoardTile:
            text: "1x3"
        BoardTile:
            text: "1x4"
        BoardTile:
            text: "2x0"
        BoardTile:
            text: "2x1"
        BoardTile:
            text: "2x2"
        BoardTile:
            text: "2x3"
        BoardTile:
            text: "2x4"
        BoardTile:
            text: "3x0"
        BoardTile:
            text: "3x1"
        BoardTile:
            text: "3x2"
        BoardTile:
            text: "3x3"
        BoardTile:
            text: "3x4"
        BoardTile:
            text: "4x0"
        BoardTile:
            text: "4x1"
        BoardTile:
            text: "4x2"
        BoardTile:
            text: "4x3"
        BoardTile:
            text: "4x4"
        BoardTile:
            text: "5x0"
        BoardTile:
            text: "5x1"
        BoardTile:
            text: "5x2"
        BoardTile:
            text: "5x3"
        BoardTile:
            text: "5x4"
    TextInput:
        pos_hint: {'x': 0.2000, 'y': 0.4000}
        size_hint: 0.6000, 0.1000
        hint_text: "Enter text..."
        font_size: 14
        foreground_color: "#6b7280"
        id: text_input
    GridLayout:
        pos_hint: {'x': 0.1000, 'y': 0.0500}
        size_hint: 0.8000, 0.2500
        cols: 10
        spacing: 10
        padding: 10
        AlphaTile:
            id: Q
            text: "Q"
        AlphaTile:
            id: W
            text: "W"
